<%
  const plainExcerpt = page.excerpt ? strip_html(page.excerpt).replace(/\s+/g, ' ').trim() : '';
  const metaDescription = (page.description || plainExcerpt || config.description || '').slice(0, 180);
  const documentTitle = page.title ? `${page.title} — ${config.author}` : config.title;
  const cleanPath = (page.path || '').replace(/index\.html$/, '');
  const canonicalUrl = `${config.url}${url_for(cleanPath)}`;
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0f13" id="meta-theme-color">
  <meta name="color-scheme" content="dark light">
  <title><%= documentTitle %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="author" content="<%= config.author %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
  <link rel="icon" href="<%- url_for(theme.favicon) %>" type="image/svg+xml">
  <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= documentTitle %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <script>
    (function () {
      var doc = document.documentElement;
      doc.classList.add('js');
      try {
        var theme = localStorage.getItem('trace-theme');
        if (theme === 'light' || theme === 'dark') doc.dataset.theme = theme;
      } catch (e) {}
    })();
  </script>
  <link rel="preload" href="<%- url_for('/fonts/jetbrains-mono-latin-400-normal.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap" as="style">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="<%- url_for(theme.styles) %>?v=<%- new Date().toISOString().slice(0, 10) %>">
</head>
