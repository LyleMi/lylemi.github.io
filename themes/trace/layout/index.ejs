<%
  const orderedPosts = site.posts.sort('date', -1).toArray();
  const recentPosts = orderedPosts.slice(0, 12);
  const featuredProjects = (theme.projects || []).slice(0, 2);
%>

<section class="home-intro">
  <div class="container home-intro__inner">
    <div class="home-intro__copy">
      <h1>安全研究、网络测量和一些工具</h1>
      <% if (config.aboutme) { %>
        <p><%= config.aboutme %></p>
      <% } %>
    </div>

    <aside class="focus-poster" aria-label="关注领域">
      <div class="focus-poster__topics">
        <strong>Web Security</strong>
        <strong>Network Measurement</strong>
      </div>
      <div class="focus-poster__notes">
        <p>
          <span>正在做</span>
          <% featuredProjects.forEach(function(project, index) { %>
            <%= index ? ' · ' : '' %><a href="<%= project.href %>" target="_blank" rel="noopener"><%= project.name %></a>
          <% }); %>
        </p>
        <p><span>持续写</span>Coding Agent · 软件工程</p>
      </div>
    </aside>
  </div>
</section>

<section class="home-section container" aria-labelledby="recent-posts-title">
  <div class="section-title">
    <h2 id="recent-posts-title">最近文章</h2>
    <a href="<%- url_for('/archives/') %>">全部文章</a>
  </div>
  <div class="post-list">
    <% recentPosts.forEach(function(post) { %>
      <%- partial('_partial/post-row', { post: post }) %>
    <% }); %>
  </div>
</section>

<section class="home-section container" id="projects" aria-labelledby="projects-title">
  <div class="section-title">
    <h2 id="projects-title">项目</h2>
    <a href="<%= theme.social.github %>" target="_blank" rel="noopener">更多项目</a>
  </div>
  <div class="project-list">
    <% (theme.projects || []).forEach(function(project) { %>
      <a class="project-row" href="<%= project.href %>" target="_blank" rel="noopener">
        <strong><%= project.name %></strong>
        <span><%= project.description %></span>
        <span aria-hidden="true">↗</span>
      </a>
    <% }); %>
  </div>
</section>
